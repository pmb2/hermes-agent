# ============================================================
# Hermes Agent — .gitignore
# ============================================================
# This file tracks patterns for files that are NEVER legitimate
# source artifacts.  Before adding a new pattern verify the
# produced filename is stable and not something a developer
# might reasonably create and want to track.
# ============================================================


# ---- Build & dependency artifacts --------------------------
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg
node_modules/
.jupyter/

# ---- IDE & editor metadata ---------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS metadata & temporary files -------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.orig
*.bak
*.tmp
*~

# ---- Generated output folders ------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
site/
*.log
test-results/

# ---- Python packaging & lockfiles (non-checkpoint) ---------
.pdm.toml
Pipfile.lock
poetry.lock
slack-bot-token.json
rules.json

# ---- Scraping & browser artifacts --------------------------
.playwright-mcp/
page*_*.txt

# ---- Cron & transient data ---------------------------------
cron.db
cron_output_snapshot.txt

# ---- Hermes update staging artifacts -----------------------
ui-tui.hermes-update-staging/
hermes-update-staging/

# ---- Tool Search live-test harness output ------------------
scripts/out/

# ---- Per-release changelog drafts --------------------------
RELEASE_v*.md

# ---- Desktop demo-run scratch output -----------------------
apps/desktop/demo/

# ---- PR infographics (stored on fal.media, never committed)
infographic/

# ---- Stale working-tree artifacts --------------------------
web_server.py.orig
github-search-openmontage.md
advisors/
pulse/

# ---- Build / runtime output directories --------------------
.pytest-cache/
data/
hermes_cli/web_dist/
